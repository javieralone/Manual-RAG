# Committable template. Copy to .env.local and replace placeholder secrets.
PYTHON_ENGINE_URL=http://rag-engine:8000
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:1.5b
AUTH_JWT_SECRET=replace-with-a-random-access-secret
AUTH_REFRESH_SECRET=replace-with-a-random-refresh-secret
AUTH_ISSUER=manual-rag-api
AUTH_AUDIENCE=manual-rag-client
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=168h
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash
AUTH_ADMIN_ROLES=admin
WORKER_LIMIT=2
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=1m
HTTP_CLIENT_TIMEOUT=5m
REQUEST_TIMEOUT=5m
READINESS_INTERVAL=15s
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
