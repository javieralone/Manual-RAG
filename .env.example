# Committable template. Copy to .env.local and replace placeholder secrets.
PYTHON_ENGINE_URL=http://rag-engine:8000
INGESTION_API_URL=http://ingestion-api:8000
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:1.5b
AUTH_JWT_SECRET=replace-with-a-random-access-secret
AUTH_REFRESH_SECRET=replace-with-a-random-refresh-secret
AUTH_ISSUER=manual-rag-api
AUTH_AUDIENCE=manual-rag-client
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=168h
AUTH_COOKIE_SECURE=true
AUTH_SESSION_REDIS_URL=redis://redis:6379/0
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash
AUTH_ADMIN_ROLES=admin
WORKER_LIMIT=2
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=1m
HTTP_CLIENT_TIMEOUT=5m
REQUEST_TIMEOUT=5m
MAX_REQUEST_BODY_BYTES=1048576
READINESS_INTERVAL=15s
SHUTDOWN_TIMEOUT=15s
DEPENDENCY_RETRY_ATTEMPTS=2
DEPENDENCY_RETRY_BACKOFF=200ms
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_RESET=30s
QDRANT_TIMEOUT_SECONDS=5
QDRANT_RETRY_ATTEMPTS=2
QDRANT_RETRY_BACKOFF_SECONDS=0.2
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
MINIO_ROOT_USER=manuals
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
MINIO_BUCKET=manuals
INGESTION_REDIS_URL=redis://redis:6379/2
INGESTION_REDIS_PREFIX=manual-rag:ingestion
INGESTION_QUEUE=ingestion
INGESTION_JOB_TIMEOUT_SECONDS=900
INGESTION_PIPELINE_TIMEOUT_SECONDS=900
INGESTION_MAX_RETRIES=3
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
DOMAIN=rag.example.com
CERTBOT_EMAIL=admin@example.com
