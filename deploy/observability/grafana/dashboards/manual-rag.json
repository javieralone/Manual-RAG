    {"type":"row","title":"Diagnóstico y Auditoría","gridPos":{"h":1,"w":24,"x":0,"y":23},"collapsed":false,"panels":[]},
    {"type":"logs","title":"Logs de Consultas y Errores","gridPos":{"h":10,"w":24,"x":0,"y":24},"datasource":{"type":"loki","uid":"loki"},"targets":[{"refId":"A","expr":"{service=~\"api-go|rag-engine\"} !~ \"(GET|POST) /(health|ready|metrics)([? ]|$)\""}]},
