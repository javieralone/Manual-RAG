    {"type":"stat","title":"Estado Motor RAG (Python)","gridPos":{"h":5,"w":6,"x":6,"y":1},"fieldConfig":{"defaults":{"thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"green","value":1}]},"mappings":[{"type":"value","options":{"0":{"text":"CAIDO"},"1":{"text":"OK"}}}]},"overrides":[]},"options":{"colorMode":"background","graphMode":"none","justifyMode":"center","orientation":"auto","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"textMode":"auto"},"targets":[{"refId":"A","expr":"rag_engine_readiness"}]},
